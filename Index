<!DOCTYPE html>

<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ResurgenceTimer — Rotation Warzone Résurgence en Direct</title>
  <meta name="description" content="Suivez en temps réel la rotation des maps Résurgence sur Warzone. Timer synchronisé mondialement — Rebirth Island et Haven's Hollow.">
  <meta name="theme-color" content="#07090f">
  <meta property="og:title" content="ResurgenceTimer — Maps Warzone Résurgence en Direct">
  <meta property="og:description" content="Timer synchronisé pour tous les joueurs du monde. Rebirth Island & Haven's Hollow.">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://resurgencetimer.com">
  <link rel="canonical" href="https://resurgencetimer.com">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;900&family=DM+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">

  <style>
    /* ═══════════════════════════════════════
       DESIGN TOKENS
    ═══════════════════════════════════════ */
    :root {
      --bg:    #07090f;
      --s1:    #0d1018;
      --s2:    #111420;
      --bdr:   #181e2e;
      --bdrhi: #232d45;

      --gold:  #e9a520;
      --goldb: rgba(233,165,32,.09);

      /* Rebirth Island — prison island, industrial green */
      --rb:    #35d474;
      --rb2:   #22a558;
      --rbb:   rgba(53,212,116,.08);

      /* Haven's Hollow — Appalachian autumn town */
      --hv:    #c4a46a;
      --hv2:   #d4884a;
      --hvb:   rgba(196,164,106,.08);

      --red:   #e04a3a;
      --t1:    #edf1f8;
      --t2:    #7d90ab;
      --t3:    #38485e;

      --fd: 'Barlow Condensed', sans-serif;
      --fb: 'DM Sans', sans-serif;
      --fm: 'JetBrains Mono', monospace;
      --r:  6px;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--t1);
      font-family: var(--fb);
      font-size: .9375rem;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
      min-height: 100dvh;
    }
    a { color: inherit; text-decoration: none; }
    button { font-family: var(--fb); cursor: pointer; border: none; background: none; }

    .page { max-width: 560px; margin: 0 auto; padding: 0 16px 96px; }

    /* ═══════════════════════════════════════
       HEADER
    ═══════════════════════════════════════ */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 0 14px;
      border-bottom: 1px solid var(--bdr);
    }
    .logo { font-family: var(--fd); font-weight: 900; font-size: 1.5rem; letter-spacing: .02em; }
    .logo-dot { color: var(--gold); }
    .logo-sub { font-family: var(--fm); font-size: .55rem; color: var(--t3); letter-spacing: .12em; display: block; margin-top: 1px; }
    .live-chip {
      display: flex; align-items: center; gap: 6px;
      font-family: var(--fm); font-size: .58rem; font-weight: 700; letter-spacing: .12em;
      color: var(--rb); background: var(--rbb);
      border: 1px solid rgba(53,212,116,.24); padding: 4px 9px; border-radius: 3px;
    }
    .live-dot {
      width: 5px; height: 5px; border-radius: 50%;
      background: var(--rb); box-shadow: 0 0 6px var(--rb);
      animation: pulse .9s ease-in-out infinite;
    }
    @keyframes pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.2;transform:scale(.5)} }

    /* ═══════════════════════════════════════
       STATUS ROW
    ═══════════════════════════════════════ */
    .status-row {
      display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
      padding: 8px 0; border-bottom: 1px solid var(--bdr);
      font-family: var(--fm); font-size: .6rem; color: var(--t3); letter-spacing: .05em;
    }
    .s-hi  { color: var(--t2); }
    .s-sep { color: var(--bdrhi); }
    .utc-chip {
      margin-left: auto; display: flex; align-items: center; gap: 5px;
      font-size: .56rem; color: var(--hv);
      background: var(--hvb); border: 1px solid rgba(196,164,106,.2);
      padding: 3px 7px; border-radius: 3px;
    }

    /* ═══════════════════════════════════════
       SECTION DIVIDER
    ═══════════════════════════════════════ */
    .sec { display: flex; align-items: center; gap: 10px; margin: 22px 0 10px; }
    .sec-lbl { font-family: var(--fm); font-size: .56rem; font-weight: 700; letter-spacing: .18em; color: var(--t3); white-space: nowrap; }
    .sec-line { flex: 1; height: 1px; background: var(--bdr); }

    /* ═══════════════════════════════════════
       MAP CARD
    ═══════════════════════════════════════ */
    .map-card {
      border-radius: var(--r); overflow: hidden;
      background: var(--s1); border: 1px solid var(--bdrhi);
      transition: border-color .5s;
    }
    .map-card[data-map=rebirth] { border-color: rgba(53,212,116,.30); }
    .map-card[data-map=haven]   { border-color: rgba(196,164,106,.30); }

    .map-topbar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 7px 13px; border-bottom: 1px solid var(--bdr);
      background: rgba(255,255,255,.018);
    }
    .map-topbar-lbl { font-family: var(--fm); font-size: .54rem; letter-spacing: .14em; color: var(--t3); }
    .map-slot-badge {
      font-family: var(--fm); font-size: .54rem; letter-spacing: .1em;
      color: var(--t2); border: 1px solid var(--bdrhi); padding: 2px 7px; border-radius: 3px;
    }

    /* ── MAP VISUAL ── */
    .map-visual {
      position: relative; height: 200px; overflow: hidden;
    }

    /* ─────────────────────────────────────────────────────────────────
       REBIRTH ISLAND — Prison island, mer émeraude, ciel orageux
       Palette : vert industriel, acier, rouille, eau froide
       ─────────────────────────────────────────────────────────────────
       NOTE : Pour utiliser votre propre screenshot (recommandé) :
         1. Prenez un screenshot in-game ou récupérez une image promotionnelle
         2. Placez le fichier dans /images/rebirth-island.jpg
         3. Décommentez la ligne "background-image: url(...)" ci-dessous
         4. Ajoutez la mention "© Activision Publishing, Inc." sur la page
       ───────────────────────────────────────────────────────────────── */
    .mv-rb {
      /* background-image: url('images/rebirth-island.jpg'); background-size:cover; background-position:center top; */

      /* Atmospheric CSS art — évoque l'île-prison industrielle */
      background-color: #050e08;
      background-image:
        /* Gradient to bottom — fade to dark for text readability */
        linear-gradient(to bottom,
          rgba(5,14,8,0)    0%,
          rgba(5,14,8,.25)  40%,
          rgba(5,14,8,.85)  72%,
          rgba(5,14,8,.98)  100%),
        /* Ciel orageux — couches de nuages */
        radial-gradient(ellipse 110% 55% at 50% 0%,   #0d2218 0%, #091a10 35%, transparent 65%),
        radial-gradient(ellipse  70% 30% at 20% 15%,  #132b1a 0%, transparent 55%),
        radial-gradient(ellipse  55% 25% at 80% 10%,  #0f2416 0%, transparent 50%),
        /* Mer émeraude — reflets en bas */
        radial-gradient(ellipse 100% 28% at 50% 100%, rgba(15,80,50,.65)  0%, transparent 70%),
        radial-gradient(ellipse  45% 18% at 30%  95%, rgba(20,100,60,.35) 0%, transparent 60%),
        /* Structures de l'île — silhouettes sombres */
        radial-gradient(ellipse  18%  62% at 42%  68%, rgba(3,8,4,.92)   0%, transparent 55%),
        radial-gradient(ellipse  12%  55% at 52%  72%, rgba(2,6,3,.88)   0%, transparent 50%),
        radial-gradient(ellipse  28%  22% at 65%  75%, rgba(5,12,6,.75)  0%, transparent 55%),
        /* Lueur verte diffuse — ambiance opérationnelle */
        radial-gradient(ellipse  60%  45% at 50%  55%, rgba(30,130,70,.12) 0%, transparent 65%),
        /* Base sombre uniforme */
        linear-gradient(160deg, #071208 0%, #050e07 60%, #040a06 100%);
    }

    /* ─────────────────────────────────────────────────────────────────
       HAVEN'S HOLLOW — Petite ville des Appalaches, automne
       Palette : ambre, ocre, brume matinale, forêt dense, chaud/froid
       ─────────────────────────────────────────────────────────────────
       NOTE : Pour utiliser votre propre screenshot :
         1. Placez le fichier dans /images/havens-hollow.jpg
         2. Décommentez la ligne "background-image: url(...)" ci-dessous
       ───────────────────────────────────────────────────────────────── */
    .mv-hv {
      /* background-image: url('images/havens-hollow.jpg'); background-size:cover; background-position:center top; */

      /* Atmospheric CSS art — évoque la ville appalache automnale */
      background-color: #0c0905;
      background-image:
        /* Gradient to bottom */
        linear-gradient(to bottom,
          rgba(12,9,5,0)    0%,
          rgba(12,9,5,.2)   38%,
          rgba(12,9,5,.82)  70%,
          rgba(12,9,5,.97)  100%),
        /* Ciel de crépuscule automnal */
        radial-gradient(ellipse 120% 50% at 50%  0%,  #251508 0%, #1a0f05 40%, transparent 65%),
        radial-gradient(ellipse  60% 30% at 25% 12%,  #2e1a08 0%, transparent 55%),
        radial-gradient(ellipse  50% 22% at 78%  8%,  #221408 0%, transparent 50%),
        /* Brume de vallée — lumière chaude diffuse */
        radial-gradient(ellipse 100% 35% at 50%  95%, rgba(120,70,20,.50)  0%, transparent 70%),
        radial-gradient(ellipse  55% 20% at 65%  90%, rgba(150,90,30,.30)  0%, transparent 60%),
        /* Silhouettes de bâtiments / clocher */
        radial-gradient(ellipse  14%  58% at 38%  68%, rgba(6,4,2,.90)   0%, transparent 52%),
        radial-gradient(ellipse   9%  70% at 48%  65%, rgba(5,3,1,.88)   0%, transparent 48%),
        radial-gradient(ellipse  30%  20% at 68%  72%, rgba(8,5,2,.72)   0%, transparent 55%),
        /* Lueur ambrée — lampadaires de village */
        radial-gradient(ellipse  25%  18% at 40%  78%, rgba(200,130,40,.18) 0%, transparent 60%),
        radial-gradient(ellipse  20%  15% at 55%  82%, rgba(180,110,30,.14) 0%, transparent 55%),
        /* Forêt dense — tons bruns/verts sombres */
        radial-gradient(ellipse  80%  40% at 15%  60%, rgba(40,25,8,.60)  0%, transparent 60%),
        radial-gradient(ellipse  70%  35% at 85%  55%, rgba(35,20,6,.55)  0%, transparent 60%),
        /* Base sombre chaude */
        linear-gradient(155deg, #100a04 0%, #0c0804 55%, #0a0703 100%);
    }

    /* Grille tactique (CSS pur — aucun droit d'auteur tiers) */
    .map-visual::after {
      content: '';
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
      background-size: 28px 28px;
      pointer-events: none; z-index: 1;
    }

    /* Badge "ACTIF" */
    .map-corner {
      position: absolute; top: 10px; right: 10px; z-index: 3;
      font-family: var(--fm); font-size: .54rem; font-weight: 700;
      letter-spacing: .1em; padding: 3px 8px; border-radius: 3px;
    }
    [data-map=rebirth] .map-corner { color: var(--rb);  background: var(--rbb);  border: 1px solid rgba(53,212,116,.28); }
    [data-map=haven]   .map-corner { color: var(--hv);  background: var(--hvb);  border: 1px solid rgba(196,164,106,.28); }

    /* Map POI tags */
    .map-pois {
      position: absolute; top: 10px; left: 10px; z-index: 3;
      display: flex; flex-direction: column; gap: 4px;
    }
    .poi-tag {
      font-family: var(--fm); font-size: .5rem; letter-spacing: .08em;
      color: rgba(255,255,255,.35); background: rgba(0,0,0,.45);
      border: 1px solid rgba(255,255,255,.06);
      padding: 2px 6px; border-radius: 2px; width: fit-content;
      backdrop-filter: blur(4px);
    }

    /* Map name overlay */
    .map-overlay {
      position: absolute; bottom: 0; left: 0; right: 0;
      padding: 14px 14px 12px; z-index: 3;
    }
    .map-name {
      font-family: var(--fd); font-weight: 900;
      font-size: 2.2rem; letter-spacing: .04em; line-height: 1;
      display: block; margin-bottom: 4px;
    }
    [data-map=rebirth] .map-name { color: var(--rb); text-shadow: 0 0 30px rgba(53,212,116,.35); }
    [data-map=haven]   .map-name { color: var(--hv); text-shadow: 0 0 30px rgba(196,164,106,.35); }

    .map-desc {
      display: flex; align-items: center; gap: 10px;
    }
    .map-desc-text {
      font-family: var(--fm); font-size: .57rem; letter-spacing: .09em; color: var(--t2);
    }
    .map-desc-sep { width: 1px; height: 10px; background: var(--bdrhi); }

    /* Copyright image */
    .map-copyright {
      position: absolute; bottom: 8px; right: 10px; z-index: 3;
      font-family: var(--fm); font-size: .48rem;
      color: rgba(255,255,255,.2); letter-spacing: .04em;
      pointer-events: none;
    }

    /* ── TIMER BLOCK ── */
    .timer-block { padding: 13px 14px; border-top: 1px solid var(--bdr); }
    .timer-row { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 9px; }
    .timer-lbl { font-family: var(--fm); font-size: .56rem; letter-spacing: .14em; color: var(--t3); }
    .timer-val {
      font-family: var(--fm); font-weight: 700;
      font-size: 2.6rem; letter-spacing: .02em; line-height: 1;
      color: var(--t1); transition: color .25s;
    }
    .timer-val.warn   { color: var(--gold); }
    .timer-val.urgent { color: var(--red); animation: blink .4s step-end infinite; }
    @keyframes blink { 50% { opacity: .35; } }

    .prog-track { height: 2px; background: var(--bdr); border-radius: 99px; overflow: hidden; margin-bottom: 9px; }
    .prog-fill  { height: 100%; border-radius: 99px; transition: width .5s linear, background .3s; }
    [data-map=rebirth] .prog-fill { background: var(--rb); }
    [data-map=haven]   .prog-fill { background: var(--hv); }
    .prog-fill.warn   { background: var(--gold)  !important; }
    .prog-fill.urgent { background: var(--red)   !important; }

    .advice-row { display: flex; align-items: center; gap: 7px; font-size: .8rem; color: var(--t2); }
    .adv-pip { width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0; }

    /* ═══════════════════════════════════════
       DUAL ROW — NEXT + ADVICE
    ═══════════════════════════════════════ */
    .dual-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }
    .info-card { border: 1px solid var(--bdr); border-radius: var(--r); background: var(--s1); padding: 12px 13px; }
    .info-lbl { font-family: var(--fm); font-size: .55rem; letter-spacing: .14em; color: var(--t3); display: block; margin-bottom: 6px; }
    .next-name { font-family: var(--fd); font-weight: 700; font-size: 1.1rem; letter-spacing: .03em; line-height: 1.25; }
    .next-name.rb { color: var(--rb); }
    .next-name.hv { color: var(--hv); }

    .adv-card { border: 1px solid; border-radius: var(--r); padding: 12px 13px; transition: border-color .25s, background .25s; }
    .adv-card.go   { border-color: rgba(53,212,116,.22);  background: var(--rbb); }
    .adv-card.wait { border-color: rgba(233,165,32,.22);  background: var(--goldb); }
    .adv-card.soon { border-color: rgba(196,164,106,.22); background: var(--hvb); }
    .adv-head { font-family: var(--fd); font-weight: 700; font-size: 1rem; letter-spacing: .03em; margin-bottom: 3px; }
    .adv-card.go   .adv-head { color: var(--rb); }
    .adv-card.wait .adv-head { color: var(--gold); }
    .adv-card.soon .adv-head { color: var(--hv); }
    .adv-body { font-size: .76rem; color: var(--t2); line-height: 1.5; }

    /* ═══════════════════════════════════════
       SYNC BANNER
    ═══════════════════════════════════════ */
    .sync-banner {
      display: flex; align-items: flex-start; gap: 10px;
      margin-top: 10px; padding: 11px 13px;
      border: 1px solid rgba(196,164,106,.14); border-radius: var(--r);
      background: rgba(196,164,106,.04);
    }
    .sync-icon { flex-shrink: 0; margin-top: 1px; }
    .sync-text { font-size: .78rem; color: var(--t2); line-height: 1.6; }
    .sync-text strong { color: var(--hv); }

    /* ═══════════════════════════════════════
       AD ZONE
    ═══════════════════════════════════════ */
    .ad-zone {
      min-height: 100px; border: 1px dashed var(--bdr); border-radius: var(--r);
      display: flex; align-items: center; justify-content: center;
      position: relative; overflow: hidden; margin-top: 10px;
    }
    .ad-lbl {
      position: absolute; top: 7px; left: 9px;
      font-family: var(--fm); font-size: .5rem; letter-spacing: .1em; color: var(--t3);
    }

    /* ═══════════════════════════════════════
       SCHEDULE
    ═══════════════════════════════════════ */
    .sched-list { display: flex; flex-direction: column; gap: 5px; }
    .sched-item {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 12px; border: 1px solid var(--bdr);
      border-radius: var(--r); background: var(--s1); font-size: .82rem;
    }
    .sched-item.now { border-color: var(--bdrhi); background: var(--s2); }
    .sched-bar { width: 3px; height: 26px; border-radius: 99px; flex-shrink: 0; }
    .sched-bar.rb   { background: var(--rb); }
    .sched-bar.hv   { background: var(--hv); }
    .sched-bar.past { background: var(--bdrhi); }
    .sched-map  { flex: 1; font-weight: 500; }
    .sched-map.dim { color: var(--t3); font-weight: 400; }
    .sched-time { font-family: var(--fm); font-size: .6rem; color: var(--t3); }
    .now-badge {
      font-family: var(--fm); font-size: .53rem; letter-spacing: .06em;
      color: var(--gold); background: var(--goldb);
      border: 1px solid rgba(233,165,32,.22); padding: 2px 6px; border-radius: 3px;
    }

    /* ═══════════════════════════════════════
       HISTORY
    ═══════════════════════════════════════ */
    .hist-list { display: flex; flex-direction: column; gap: 5px; }
    .hist-item {
      display: flex; align-items: center; gap: 10px;
      padding: 9px 12px; border: 1px solid var(--bdr);
      border-radius: var(--r); background: var(--s1); font-size: .82rem;
    }
    .hist-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
    .hist-dot.rb { background: var(--rb); }
    .hist-dot.hv { background: var(--hv); }
    .hist-map  { flex: 1; font-weight: 500; }
    .hist-time { font-family: var(--fm); font-size: .6rem; color: var(--t3); }
    .hist-empty { font-family: var(--fm); font-size: .63rem; color: var(--t3); padding: 8px 0; }

    /* ═══════════════════════════════════════
       CARDS (Notifications, Settings)
    ═══════════════════════════════════════ */
    .card { border: 1px solid var(--bdr); border-radius: var(--r); background: var(--s1); padding: 14px; }
    .card-desc { font-size: .82rem; color: var(--t2); line-height: 1.65; margin-bottom: 12px; }
    .card-desc strong { color: var(--t1); font-weight: 600; display: block; margin-bottom: 2px; }

    .btn-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
    .btn {
      font-family: var(--fb); font-weight: 600; font-size: .8rem;
      letter-spacing: .03em; padding: 8px 14px;
      border-radius: var(--r); border: 1px solid transparent; transition: .15s;
    }
    .btn-primary { background: var(--gold); color: #000; border-color: var(--gold); }
    .btn-primary:hover { filter: brightness(1.08); }
    .btn-primary:disabled { opacity: .45; cursor: default; filter: none; }
    .btn-ghost  { background: transparent; border-color: var(--bdrhi); color: var(--t2); }
    .btn-ghost:hover { border-color: var(--t2); color: var(--t1); }
    .btn-ghost.on-rb { border-color: var(--rb); color: var(--rb); }
    .btn-ghost.on-hv { border-color: var(--hv); color: var(--hv); }
    .notif-status { font-family: var(--fm); font-size: .6rem; color: var(--t3); letter-spacing: .04em; }

    /* ── Settings ── */
    .settings-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .settings-info { flex: 1; }
    .settings-info strong { display: block; font-weight: 600; font-size: .88rem; margin-bottom: 2px; }
    .settings-info span   { font-size: .76rem; color: var(--t2); }
    .dur-ctrl { display: flex; align-items: center; gap: 8px; }
    .dur-btn {
      width: 28px; height: 28px;
      border: 1px solid var(--bdrhi); border-radius: 4px;
      background: transparent; color: var(--t1); font-size: 1rem;
      display: flex; align-items: center; justify-content: center; transition: .15s;
    }
    .dur-btn:hover { border-color: var(--gold); color: var(--gold); }
    .dur-val { font-family: var(--fm); font-size: .86rem; min-width: 48px; text-align: center; }

    /* ═══════════════════════════════════════
       PiP OVERLAY CARD
    ═══════════════════════════════════════ */
    .pip-card {
      border: 1px solid var(--bdr); border-radius: var(--r);
      background: var(--s1); padding: 14px;
      display: flex; gap: 13px; align-items: flex-start;
    }
    .pip-icon {
      width: 40px; height: 40px; border-radius: 8px; flex-shrink: 0;
      background: var(--goldb); border: 1px solid rgba(233,165,32,.18);
      display: flex; align-items: center; justify-content: center;
    }
    .pip-body { flex: 1; }
    .pip-body strong { display: block; font-weight: 600; font-size: .9rem; margin-bottom: 3px; }
    .pip-body p { font-size: .78rem; color: var(--t2); line-height: 1.55; margin-bottom: 10px; }
    .pip-btns { display: flex; gap: 8px; flex-wrap: wrap; }
    .pip-btn {

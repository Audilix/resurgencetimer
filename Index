<script>
'use strict';

/* ── CONFIG ─────────────────────────────────────────────────── */
const MAPS = [
  {
    id:     'rebirth',
    name:   'Rebirth Island',
    vis:    'mv-rb',
    slot:   '1/2',
    region: 'ARCHIPEL DE LA MER NOIRE',
    size:   'PETITE — 11 POI',
    cls:    'rb',
    pois:   ['PRISON', 'DOCK', 'HEADQUARTERS', 'INDUSTRY'],
  },
  {
    id:     'haven',
    name:   "Haven's Hollow",
    vis:    'mv-hv',
    slot:   '2/2',
    region: 'APPALACHES — VIRGINIE-OCCIDENTALE',
    size:   'MOYENNE — 9 POI',
    cls:    'hv',
    pois:   ['MAIN STREET', 'MANSION', 'LUMBER MILL', 'CHURCH'],
  },
];

let ROT_MIN = parseInt(localStorage.getItem('rt_dur') || '25', 10);
let ALERTS  = JSON.parse(localStorage.getItem('rt_alerts') || '[]');

/* ── UTC SYNC ENGINE ────────────────────────────────────────── */
const cycleMs  = () => ROT_MIN * 60 * 1000;
const getSlot  = () => Math.floor(Date.now() / cycleMs()) % MAPS.length;
const getSecsL = () => (cycleMs() - (Date.now() % cycleMs())) / 1000;

/* ── DOM ────────────────────────────────────────────────────── */
const G = id => document.getElementById(id);
const E = {
  card:   G('mapCard'),   vis:    G('mapVis'),     corner: G('mapCorner'),
  name:   G('mapName'),   region: G('mapRegion'),  size:   G('mapSize'),
  pois:   G('mapPois'),   slot:   G('slotBadge'),
  timer:  G('timerVal'),  prog:   G('progFill'),   pip:    G('advPip'),
  advInl: G('advInline'), advCard:G('advCard'),    advH:   G('advHead'),
  advB:   G('advBody'),   next:   G('nextName'),   clock:  G('clock'),
  tz:     G('tz'),        durVal: G('durVal'),
  sched:  G('schedList'), hist:   G('histList'),
  nStatus:G('notifStatus'), nBtn: G('notifBtn'),
};

let lastSlot = -1;
const sessionHist = [];

/* ── SCHEDULE ───────────────────────────────────────────────── */
function buildSched() {
  const cycle = cycleMs(), now = Date.now();
  const cur   = Math.floor(now / cycle);
  const back  = Math.ceil((2 * 60) / ROT_MIN);
  const fwd   = Math.ceil((6 * 60) / ROT_MIN);
  let html = '';
  for (let i = -back; i <= fwd; i++) {
    const si   = cur + i;
    const s    = si * cycle, e = s + cycle;
    const mi   = ((si % MAPS.length) + MAPS.length) % MAPS.length;
    const map  = MAPS[mi];
    const isNow= s <= now && now < e;
    const past = e <= now;
    const t    = localTime(new Date(s));
    html += `<div class="sched-item${isNow?' now':''}">
      <div class="sched-bar ${past?'past':map.cls}"></div>
      <div class="sched-map${past?' dim':''}">${map.name}</div>
      <div class="sched-time">${t}</div>
      ${isNow?'<span class="now-badge">EN COURS</span>':''}
    </div>`;
  }
  E.sched.innerHTML = html;
}

/* ── HISTORY ────────────────────────────────────────────────── */
function addHist(map) {
  sessionHist.unshift({ map, time: new Date() });
  if (sessionHist.length > 8) sessionHist.pop();
  renderHist();
}
function renderHist() {
  if (!sessionHist.length) {
    E.hist.innerHTML = '<div class="hist-empty">Aucun changement depuis l\'ouverture de la page.</div>';
    return;
  }
  E.hist.innerHTML = sessionHist.map((h, i) => {
    const t   = h.time.toLocaleTimeString(USER_LOCALE, {hour:'2-digit', minute:'2-digit', second:'2-digit'});
    const ago = Math.round((Date.now() - h.time) / 60000);
    return `<div class="hist-item">
      <div class="hist-dot ${h.map.cls}"></div>
      <div class="hist-map">${h.map.name}</div>
      <div class="hist-time">${t} &mdash; ${i===0?'En cours':`il y a ${ago} min`}</div>
    </div>`;
  }).join('');
}

/* ── MAIN LOOP ──────────────────────────────────────────────── */
function update() {
  const slot  = getSlot(), secsL = getSecsL();
  const total = ROT_MIN * 60, pct = ((total - secsL) / total) * 100;
  const map   = MAPS[slot], next = MAPS[(slot+1) % MAPS.length];
  const m = Math.floor(secsL/60), s = Math.floor(secsL%60);
  const pad = n => String(Math.floor(n)).padStart(2, '0');

  /* Map switch */
  if (slot !== lastSlot) {
    if (lastSlot !== -1) {
      if (ALERTS.includes(map.id) && Notification.permission === 'granted')
        new Notification(`${map.name} est maintenant active !`, { body:'Rotation en cours — déployez !' });
      addHist(map);
    }
    /* Update card */
    E.card.dataset.map = map.id;
    E.vis.className    = `map-visual ${map.vis}`;
    E.name.textContent   = map.name;
    E.region.textContent = map.region;
    E.size.textContent   = map.size;
    E.slot.textContent   = `SLOT ${map.slot}`;
    E.next.textContent   = next.name;
    E.next.className     = `next-name ${next.cls}`;
    E.pip.style.background = `var(--${map.cls})`;
    /* POI tags */
    E.pois.innerHTML = map.pois.map(p => `<div class="poi-tag">${p}</div>`).join('');
    buildSched();
    lastSlot = slot;
  }

  /* Timer */
  E.timer.textContent = `${pad(m)}:${pad(s)}`;
  E.timer.classList.remove('warn','urgent');
  E.prog.classList.remove('warn','urgent');
  if (secsL <= 30)       { E.timer.classList.add('urgent'); E.prog.classList.add('urgent'); }
  else if (secsL <= 120) { E.timer.classList.add('warn');   E.prog.classList.add('warn'); }
  E.prog.style.width = `${Math.min(pct, 100)}%`;

  /* Inline advice */
  if (secsL <= 30)        E.advInl.textContent = `Rotation dans ${Math.ceil(secsL)}s — ${next.name} arrive`;
  else if (secsL <= 120)  E.advInl.textContent = `${next.name} dans moins de 2 minutes`;
  else if (pct < 15)      E.advInl.textContent = `Pleine fenêtre disponible sur ${map.name}`;
  else                    E.advInl.textContent = `${pad(m)}:${pad(s)} restantes sur ${map.name}`;

  /* Advice card */
  let cls, head, body;
  if (secsL <= 60) {
    cls='soon'; head='Attends la rotation';
    body=`${next.name} arrive dans ${Math.ceil(secsL)}s.`;
  } else if (pct >= 72) {
    cls='wait'; head='Fin de fenêtre';
    body=`${pad(m)}:${pad(s)} restantes. Lance si tu es rapide.`;
  } else {
    cls='go'; head='Lance ta partie';
    body=`${pad(m)}:${pad(s)} sur ${map.name}.`;
  }
  E.advCard.className = `adv-card ${cls}`;
  E.advH.textContent = head; E.advB.textContent = body;

  E.clock.textContent = new Date().toLocaleTimeString(USER_LOCALE);
}

/* ── DURATION ───────────────────────────────────────────────── */
E.durVal.textContent = ROT_MIN;
function changeDur(d) {
  ROT_MIN = Math.max(5, Math.min(60, ROT_MIN + d));
  E.durVal.textContent = ROT_MIN;
  localStorage.setItem('rt_dur', ROT_MIN);
  lastSlot = -1; buildSched();
}

/* ── NOTIFICATIONS ──────────────────────────────────────────── */
function requestNotif() {
  if (!('Notification' in window)) { E.nStatus.textContent = 'Non supporté par ce navigateur.'; return; }
  Notification.requestPermission().then(syncNotifUI);
}
function toggleAlert(id) {
  if (Notification.permission !== 'granted') { requestNotif(); return; }
  ALERTS = ALERTS.includes(id) ? ALERTS.filter(a=>a!==id) : [...ALERTS, id];
  localStorage.setItem('rt_alerts', JSON.stringify(ALERTS));
  syncBtns();
}
function syncBtns() {
  G('btnRb').className = 'btn btn-ghost' + (ALERTS.includes('rebirth') ? ' on-rb' : '');
  G('btnHv').className = 'btn btn-ghost' + (ALERTS.includes('haven')   ? ' on-hv' : '');
  const a = ALERTS.map(id => MAPS.find(m=>m.id===id)?.name).filter(Boolean);
  E.nStatus.textContent = a.length ? `Alertes actives : ${a.join(', ')}.` : 'Aucune alerte sélectionnée.';
}
function syncNotifUI(perm) {
  if (perm==='granted') { G('notifBtn').textContent='Notifications activées'; G('notifBtn').disabled=true; syncBtns(); }
  else if (perm==='denied') E.nStatus.textContent = 'Notifications bloquées. Modifiez les permissions de votre navigateur.';
}
if ('Notification' in window && Notification.permission !== 'default') syncNotifUI(Notification.permission);
syncBtns();

/* ── MODALS ─────────────────────────────────────────────────── */
function openModal(n)  { G(n+'Modal').classList.add('open'); }
function closeModal(n) { G(n+'Modal').classList.remove('open'); }
document.querySelectorAll('.modal').forEach(m => {
  m.addEventListener('click', e => { if (e.target===m) m.classList.remove('open'); });
});

/* ── INIT + LOCALISATION AUTOMATIQUE ───────────────────────────
   Détecte la langue ET le fuseau horaire du visiteur.
   Un joueur en France voit 14:32, au Japon 21:32 — le TIMER
   reste identique car basé sur Date.now() UTC mondial.
   ─────────────────────────────────────────────────────────────── */
const USER_LOCALE = navigator.language || 'fr-FR';
const USER_TZ     = Intl.DateTimeFormat().resolvedOptions().timeZone;

function localTime(date, extra = {}) {
  return date.toLocaleTimeString(USER_LOCALE, { hour:'2-digit', minute:'2-digit', ...extra });
}

function tzLabel() {
  const city = USER_TZ.split('/').pop().replace(/_/g,' ');
  const off  = -new Date().getTimezoneOffset();
  const sign = off >= 0 ? '+' : '\u2212';
  const h    = Math.floor(Math.abs(off) / 60);
  const mn   = Math.abs(off) % 60;
  const utc  = mn ? `UTC${sign}${h}:${String(mn).padStart(2,'0')}` : `UTC${sign}${h}`;
  return `${city} \u00b7 ${utc}`;
}

E.tz.textContent = tzLabel();
G('year').textContent = new Date().getFullYear();

/* Seed history on load */
(function seed() {
  const cycle = cycleMs(), now = Date.now(), cur = Math.floor(now / cycle);
  for (let i = 2; i >= 0; i--) {
    const si = cur - i;
    const mi = ((si % MAPS.length) + MAPS.length) % MAPS.length;
    sessionHist.push({ map:MAPS[mi], time:new Date(si * cycle) });
  }
  renderHist();
})();

buildSched();
update();
setInterval(update, 500);
setInterval(buildSched, 30_000);

/* ══════════════════════════════════════════════════════════════
   PICTURE-IN-PICTURE
   Fenêtre flottante canvas → reste visible par-dessus le jeu.
   Chrome 70+ / Edge 79+ / Safari 14+
   ══════════════════════════════════════════════════════════════ */
let _pipCanvas, _pipCtx, _pipVideo, _pipTick, _pipOn = false;

function initPiP() {
  const ok = document.pictureInPictureEnabled;
  const btn = G('pipStartBtn'), st = G('pipStatus');
  if (ok) { btn.disabled = false; st.textContent = 'Compatible. Cliquez pour ouvrir la fenêtre flottante.'; }
  else    { btn.disabled = true;  st.textContent = 'Non disponible sur ce navigateur (Chrome, Edge ou Safari 14+ requis).'; }
}

async function startPiP() {
  if (!document.pictureInPictureEnabled || _pipOn) return;
  _pipCanvas = document.createElement('canvas');
  _pipCanvas.width = 320; _pipCanvas.height = 180;
  _pipCtx  = _pipCanvas.getContext('2d');
  _pipVideo = document.createElement('video');
  _pipVideo.muted = true;
  _pipVideo.srcObject = _pipCanvas.captureStream(2);
  _pipVideo.addEventListener('leavepictureinpicture', () => {
    _pipOn = false; clearInterval(_pipTick);
    G('pipStartBtn').style.display = '';
    G('pipStopBtn').style.display  = 'none';
    const s = G('pipStatus'); s.textContent = 'Fenêtre fermée.'; s.classList.remove('active');
  });
  drawPiP();
  try {
    await _pipVideo.play();
    await _pipVideo.requestPictureInPicture();
    _pipOn  = true; _pipTick = setInterval(drawPiP, 500);
    G('pipStartBtn').style.display = 'none';
    G('pipStopBtn').style.display  = '';
    const s = G('pipStatus'); s.textContent = 'Fenêtre flottante active — minimisez cet onglet.'; s.classList.add('active');
  } catch(e) {
    G('pipStatus').textContent = 'Erreur — interagissez d\'abord avec la page puis réessayez.';
  }
}

function stopPiP() {
  if (document.pictureInPictureElement) document.exitPictureInPicture();
}

function drawPiP() {
  if (!_pipCtx) return;
  const slot  = getSlot(), secsL = getSecsL();
  const map   = MAPS[slot], next = MAPS[(slot+1) % MAPS.length];
  const m = Math.floor(secsL/60), s = Math.floor(secsL%60);
  const pad   = n => String(Math.floor(n)).padStart(2,'0');
  const W=320, H=180, ctx=_pipCtx;
  const col  = map.id==='rebirth' ? '#35d474' : '#c4a46a';
  const tcol = secsL<=30 ? '#e04a3a' : secsL<=120 ? '#e9a520' : '#edf1f8';

  ctx.fillStyle='#07090f'; ctx.fillRect(0,0,W,H);
  /* Left bar */
  ctx.fillStyle=col; ctx.fillRect(0,0,3,H);
  /* Grid */
  ctx.strokeStyle='rgba(255,255,255,.022)'; ctx.lineWidth=1;
  for(let x=0;x<W;x+=28){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();}
  for(let y=0;y<H;y+=28){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}
  /* Logo */
  ctx.fillStyle='#2a3450'; ctx.font='700 9px monospace'; ctx.textAlign='left';
  ctx.fillText('RESURGENCETIMER.COM', 12, 18);
  ctx.textAlign='right'; ctx.fillStyle='#38485e'; ctx.fillText('RÉSURGENCE', W-10, 18);
  /* Map name */
  ctx.fillStyle=col; ctx.font='bold 20px sans-serif'; ctx.textAlign='left';
  ctx.fillText(map.name.toUpperCase(), 12, 54);
  /* Divider */
  ctx.fillStyle='#181e2e'; ctx.fillRect(12,60,W-24,1);
  /* Timer label */
  ctx.fillStyle='#38485e'; ctx.font='600 9px monospace'; ctx.fillText('PROCHAIN CHANGEMENT', 12, 78);
  /* Timer */
  if(secsL<=30){ctx.shadowColor='#e04a3a';ctx.shadowBlur=14;}
  ctx.fillStyle=tcol; ctx.font='bold 54px monospace'; ctx.textAlign='left';
  ctx.fillText(`${pad(m)}:${pad(s)}`, 7, 145);
  ctx.shadowBlur=0;
  /* Progress */
  const pW=W-24, fl=Math.min((1-secsL/(ROT_MIN*60))*pW,pW);
  ctx.fillStyle='#181e2e'; ctx.fillRect(12,152,pW,3);
  ctx.fillStyle=tcol; ctx.fillRect(12,152,fl,3);
  /* Next */
  ctx.fillStyle='#38485e'; ctx.font='600 9px monospace'; ctx.textAlign='right';
  ctx.fillText(`NEXT: ${next.name.toUpperCase()}`, W-10, 170);
}

initPiP();
</script>

